# TempCPU — configuração (copie para .env e ajuste). Temperaturas em °C.
INTERVALO_S=2
# Limites das zonas do gráfico
ALERTA_C=75
QUENTE_C=90
# Início da zona crítica. auto = limite de redução de desempenho definido pelo firmware (101 °C neste notebook);
# sem firmware, usa 105 (Tjmax do Ryzen 7 4800HS). Um número fixa o valor.
DANO_C=auto
# Histórico exibido no gráfico, em minutos
JANELA_MIN=5
# Intervalo da coleta de processos/plano de energia, em segundos
DIAGNOSTICO_S=4
# Leitura ACPI sem mudar por este tempo (minutos) é marcada como parada
PARADA_MIN=3
# Ventoinha acima disto (RPM) conta como rotação alta no diagnóstico
FAN_ALTA_RPM=4500
# Histórico (SQLite em %LOCALAPPDATA%\TempCPU\historico.db)
# Com a janela minimizada, o diagnóstico (programas, energia) é coletado a cada tantos segundos
DIAGNOSTICO_OCULTO_S=30
# Minutos guardados por este número de dias; resumos por hora/dia/semana/mês ficam para sempre
RETENCAO_DIAS=365
# sim = guarda o nome do programa que mais consome CPU a cada minuto; nao = nunca guarda nomes de programas
SALVAR_PROGRAMAS=sim
# Número do ícone (barra de tarefas e bandeja): redesenhado a cada tantos segundos com o valor daquele instante,
# ou na hora em que a faixa de cor (ou o estado: pausado, sem leitura, parada) muda
ICONE_ATUALIZA_S=60
