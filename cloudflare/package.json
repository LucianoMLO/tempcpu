{
  "name": "tempcpu-avaliacao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Avaliação e certificado do Laboratório do TempCPU (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test \"test/*.test.ts\"",
    "tipos": "tsc --noEmit",
    "banco:exemplo": "node scripts/usar-banco.mjs exemplo",
    "banco:real": "node scripts/usar-banco.mjs real",
    "d1:local": "wrangler d1 execute tempcpu-avaliacao --local --file=schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
